{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/aquistus/.config/fastfetch/nixos_ascii.txt",
    "position": "top",
    "color": {
      "1": "blue",
      "2": "cyan"
    },
    "padding": {
      "top": 0,
      "left": 0,
      "right": 0
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 0
    },
    "color": {
      "keys": "blue",
      "title": "bold_cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "╭──────────────╮"
    },
    {
      "type": "os",
      "key": "│   OS        │",
      "keyColor": "cyan"
    },
    {
      "type": "host",
      "key": "│ 󰌢  Host      │",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "│ 󰒋  Kernel    │",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐  Uptime    │",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "│ 󰏖  Packages  │",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "│ 󰞷  Shell     │",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "│ 󰞍  Terminal  │",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "│ 󰍛  CPU       │",
      "keyColor": "cyan",
      "showPeCoreCount": false
    },
    {
      "type": "gpu",
      "key": "│ 󰢮  GPU       │",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "│ 󰍛  Memory    │",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "│ 󰋊  Disk      │",
      "keyColor": "cyan",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "╰──────────────╯"
    }
  ]
}
